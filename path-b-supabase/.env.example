# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 실제 값을 넣으세요.
# .env 는 .gitignore 에 들어 있어 깃허브에 올라가지 않습니다.

# Supabase 대시보드 > Project Settings > Data API 의 Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase 대시보드 > Settings > API Keys 의 Publishable key (sb_publishable_ 로 시작)
# ⚠ Secret key(sb_secret_...)는 넣지 마세요. RLS가 무시됩니다. (넣으면 서버가 시작을 거부합니다)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 서버 포트 (Render는 자동으로 정해 주므로 거기서는 넣지 않아도 됨)
PORT=3000

# 내 컴퓨터: 127.0.0.1 / Render: 0.0.0.0
HOST=127.0.0.1

# 내 컴퓨터: development / Render: production (HTTPS 전용 쿠키가 켜짐)
NODE_ENV=development

# (선택) npm run check-rls 로 '사용자끼리 막히는지' 볼 때 쓰는 시험용 계정 두 개
# 앱에서 먼저 이 두 이메일로 가입해 두세요.
RLS_TEST_EMAIL_A=
RLS_TEST_PASSWORD_A=
RLS_TEST_EMAIL_B=
RLS_TEST_PASSWORD_B=
